{
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "model": "opusplan",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/shiru/.claude/hooks/rtk-rewrite.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if [[ \"$CLAUDE_FILE_PATHS\" == */data/raw/* ]]; then echo 'BLOCKED: data/raw/ is read-only' >&2; exit 1; fi",
            "timeout": 5000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if [[ \"$CLAUDE_FILE_PATHS\" == *.py ]]; then ruff check --fix \"$CLAUDE_FILE_PATHS\" 2>/dev/null && ruff format \"$CLAUDE_FILE_PATHS\" 2>/dev/null; fi",
            "timeout": 10000
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "skipDangerousModePermissionPrompt": true,
  "autoUpdaterStatus": "disabled",
  "theme": "dark-ansi"
}
