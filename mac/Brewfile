# macOS 用 Homebrew パッケージ（dotfiles が動くのに必要な最低限）
# 使い方: brew bundle --file=~/dotfiles/mac/Brewfile
# それ以外のツールやアプリは各自で入れる

brew "git"
brew "git-lfs"       # .gitconfig の lfs フィルタ
brew "gh"            # .gitconfig の credential helper
brew "jq"            # statusline.sh
brew "rtk"           # Claude Code トークン節約フック
brew "eza"           # alias ls
brew "fzf"           # .zshrc / alias cdc
brew "node"          # Claude Code / Codex / npx skills
brew "zellij"        # alias ze

cask "ghostty"               # mac/ghostty/config
cask "font-plemol-jp-nf"     # ghostty: PlemolJP35 Console NF
